{
  "name": "CloudSaver",
  "package": "cloud.lazycat.app.cloudsaver",
  "description": "一个基于 Vue 3 + Express 的网盘资源搜索与转存工具",
  "homepage": "https://github.com/jiangrui1994/CloudSaver",
  "author": "jiangrui1994",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "cloudsaver",
  "version": "0.3.3",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "cloudsaver_8008_8008": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_jiangrui1994_cloudsaver_0.3.3": {
    "originalImage": "jiangrui1994/cloudsaver:0.3.3",
    "pushTarget": "none"
  },
  "cloudsaver_volume_/app/data_action": "emptyDir",
  "cloudsaver_volume_/app/data_location": "app_data",
  "cloudsaver_volume_/app/config_action": "emptyDir",
  "cloudsaver_volume_/app/config_location": "app_data"
}
